lastver 1.1f
conf 1.1 $30=255 $110=3000 $130=300
fw grbl
fastconnect
newprog G0 X10 Y20\nG1 X50 Y80 F500\nG1 X30 Y40
rx <Idle|MPos:12.500,-3.250,1.000|WCO:2.500,1.500,0.250>
jogset 3000 5.5
custom G0 X[left] Y[bottom]\nG0 X[right] Y[top]\nG1 X[width/2] Y[height*2]
custom M3 S[$30*0.5]\n\n   \nG1 F[jogspeed] X[jogstep]
custom G0 X[MPos.X+WCO.X] Y[WPos.Y]
custom G0 X[nope] Y[1/0] Z[1+]
custom $H
custom ?
custom !
custom ~
custom 0x85
custom 0X18
custom ctrl-x
custom CTRL-X
custom 0xZZ
custom 0x123
custom 0x
custom G1 X[$130]  (comment)
custom [$31]
custom G91\r\nG1 X1\r\nG90
eval G0 X[left] Y[bottom] F[$110]
eval  [1+2] [3*4.123456]  
eval [0.0005] [-0.0004] [1/3]
eval [Round(2.5)] [Sqrt(2)]
tx 12
dump
